# Registriert Plugin-Code und Produktname und bricht ab, wenn einer doppelt vergeben wird.
# Verhindert, dass sich zwei Plugins in der DAW gegenseitig ueberschreiben oder verwechseln.
function(nwa_claim_plugin_identity target plugin_code product_name)
    string(LENGTH "${plugin_code}" _len)
    if(NOT _len EQUAL 4)
        message(FATAL_ERROR "${target}: PLUGIN_CODE '${plugin_code}' muss genau 4 Zeichen haben")
    endif()
    if(NOT plugin_code MATCHES "[A-Z]")
        message(FATAL_ERROR "${target}: PLUGIN_CODE '${plugin_code}' braucht mindestens einen Grossbuchstaben")
    endif()
    if(product_name MATCHES "[/\\\\:*?\"<>|]")
        message(FATAL_ERROR "${target}: PRODUCT_NAME '${product_name}' enthaelt Zeichen, die in Dateinamen verboten sind")
    endif()
    get_property(_codes GLOBAL PROPERTY NWA_PLUGIN_CODES)
    get_property(_names GLOBAL PROPERTY NWA_PLUGIN_NAMES)
    string(TOLOWER "${product_name}" _lname)
    if("${plugin_code}" IN_LIST _codes)
        message(FATAL_ERROR "${target}: PLUGIN_CODE '${plugin_code}' ist bereits vergeben")
    endif()
    if("${_lname}" IN_LIST _names)
        message(FATAL_ERROR "${target}: PRODUCT_NAME '${product_name}' ist bereits vergeben")
    endif()
    set_property(GLOBAL APPEND PROPERTY NWA_PLUGIN_CODES "${plugin_code}")
    set_property(GLOBAL APPEND PROPERTY NWA_PLUGIN_NAMES "${_lname}")
endfunction()
